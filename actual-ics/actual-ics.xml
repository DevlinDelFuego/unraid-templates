<?xml version="1.0"?>
<Container version="2">
  <Name>actual-ical</Name>
  <Repository>ghcr.io/matheusvellone/actual-ical</Repository>
  <Registry/>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://forums.unraid.net/topic/195220-support-devlindelfuego-all-images-and-files/</Support>
  <Project>https://github.com/matheusvellone/actual-ical</Project>
  <ReadMe/>
  <Overview>A simple application to expose Actual Scheduled Transactions in iCal format.</Overview>
  <Category>Productivity:</Category>
  <WebUI>http://[IP]:[PORT:3000]/</WebUI>
  <TemplateURL/>
  <Icon>https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/actual-budget.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Appdata" Target="/app/.actual-cache" Default="" Mode="rw" Description="" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/actual-ical</Config>
  <Config Name="Port" Target="3000" Default="3000" Mode="tcp" Description="" Type="Port" Display="always" Required="false" Mask="false">3000</Config>
  <Config Name="ACTUAL_SERVER" Target="ACTUAL_SERVER" Default="http://actual.example.com" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false">http://ActualServer:5006</Config>
  <Config Name="ACTUAL_MAIN_PASSWORD" Target="ACTUAL_MAIN_PASSWORD" Default="" Mode="" Description="" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="ACTUAL_SYNC_ID" Target="ACTUAL_SYNC_ID" Default="" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="TZ" Target="TZ" Default="" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="LOCALE" Target="LOCALE" Default="en-US" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false">en-US</Config>
  <Config Name="CURRENCY" Target="CURRENCY" Default="USD" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false">USD</Config>
  <Config Name="SYNC_ID_AS_URL" Target="SYNC_ID_AS_URL" Default="false" Mode="" Description="http://localhost:3000/{ACTUAL_SYNC_ID}.ics" Type="Variable" Display="always" Required="false" Mask="false">false</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
  <Config Name="UMASK" Target="UMASK" Default="022" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">022</Config>
  <Config Name="LOG_LEVEL" Target="LOG_LEVEL" Default="info" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">info</Config>
  <TailscaleStateDir/>
</Container>